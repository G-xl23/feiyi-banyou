# ========= 服务配置 =========
PORT=3000
NODE_ENV=production

# ========= 大模型配置（可选，OpenAI 兼容接口）=========
# 三项（BASE_URL / API_KEY / MODEL）要么都填、要么都留空：
#   · 都留空 → 系统使用内置离线模板生成，功能完整可演示（无需任何密钥）
#   · 都填写 → 智能对话由大模型接管，回答自动标注模型名称与版本
# 本项目已在北邮大模型网关（https://myai.bupt.edu.cn/llm-gw/v1，模型 deepseek-v4-flash）上实测通过，
# 部署时替换为你自己的网关与密钥即可（本文件不写入真实密钥；真实密钥请放在 server/.env，该文件不入库）。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 大模型应答通常需 10~30 秒，超时建议不低于 60000，避免长回答被中断
LLM_TIMEOUT_MS=60000
